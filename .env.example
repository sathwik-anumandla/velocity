# ==============================================================================
# Velocity Personal AI Agent Configuration
# ==============================================================================

# 1. LLM Configuration (Luna & Fast Retain Model)
# Pinned OpenAI Luna configuration:
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL_ID=gpt-5.6
CLASSIFIER_MODEL_ID=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# Separate Cheap Model for Hindsight Retain Extraction (e.g. gpt-4o-mini or gpt-5-nano)
RETAIN_LLM_PROVIDER=openai
RETAIN_LLM_MODEL=gpt-4o-mini

# 2. Tavily Web Search API
TAVILY_API_KEY=your-tavily-api-key-here

# 3. Vectorize Hindsight & Postgres Configuration (Docker Stack)
POSTGRES_USER=hindsight
POSTGRES_PASSWORD=velocity_secure_hindsight_db_pass
POSTGRES_DB=hindsight

# Pinned Worker ID for Hindsight Background Worker
HINDSIGHT_API_WORKER_ID=velocity-worker-1

# Hindsight Client Endpoint & Memory Bank ID
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_BANK_ID=personal-agent

# 4. Local Persistence (SQLite)
SQLITE_DB_PATH=./data/velocity.db

# 5. Logging & Telemetry
AGENT_VERBOSE=true

# 6. Cloudflare Access Configuration
CF_ACCESS_CLIENT_ID=your-client-id.access
CF_ACCESS_CLIENT_SECRET=your-client-secret-here